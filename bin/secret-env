#!/usr/bin/env bash
# Print shell `export` lines for KeePassXC entries env/<NAME>, with one vault
# unlock for all names. bin/secret unlocks once per entry, so a shell startup
# that needs many secrets uses this instead.
#
# Usage: eval "$(secret-env NAME...)"
#
# A missing entry prints a warning to stderr and exports nothing for it. If the
# vault cannot be opened, this prints a warning and exits 1, and the eval in the
# caller runs nothing, so the shell still starts.
set -euo pipefail

KPDB="${KPDB:-$HOME/.local/share/keepassxc/secrets.kdbx}"
(( $# > 0 )) || { echo "usage: secret-env NAME..." >&2; exit 2; }

# The decrypted export goes through a pipe only, never a variable or a file.
security find-generic-password -a "$USER" -s keepassxc-db -w \
  | keepassxc-cli export -q -f csv "$KPDB" \
  | python3 -c '
import csv, shlex, sys
rows = list(csv.DictReader(sys.stdin))
if not rows:
    print("secret-env: cannot read the vault", file=sys.stderr)
    sys.exit(1)
values = {r["Title"]: r["Password"] for r in rows if r["Group"].split("/")[-1] == "env"}
for name in sys.argv[1:]:
    if name in values:
        print(f"export {name}={shlex.quote(values[name])}")
    else:
        print(f"secret-env: no entry env/{name}", file=sys.stderr)
' "$@"
