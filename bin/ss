#! /usr/bin/env zsh

local selected_tmux_session=""
if [ -z "$1" ]; then
  tmux popup -E "tmux list-sessions -F '#{session_last_attached} #S' | sort -r | sed '1d'| awk '{ print \$2 }' | fzf | xargs tmux switch-client -t"
else
  local tmux_sessions=$(tmux list-sessions -F "#S")
  local selected_tmux_session=$( echo "$tmux_sessions" | fzf --query="$1" --select-1 --exit-0)
  tmux switch-client -t "$selected_tmux_session"
fi

