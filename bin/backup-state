#!/usr/bin/env bash
#
# Back up local state that git must not hold: the secrets vault, zsh history,
# orch state, and agent session logs.
#
# Usage: BACKUP_DIR=<dir> backup-state
#
# Layout in $BACKUP_DIR:
#   snapshots/YYYY-MM-DD/   secrets.kdbx, zsh_history, orch.db, orch-ledger.json
#                           The newest $BACKUP_KEEP_DAYS (default 14) are kept.
#   mirror/orch-logs/       rsync copies. New and changed files are copied.
#   mirror/pi-sessions/     Files deleted locally stay in the mirror.
#
# Each snapshot is built in a local temp directory, then copied in. So SQLite
# never writes into a synced folder, and a half-written snapshot never appears.
# orch.db is copied with `sqlite3 .backup`, which gives a consistent copy while
# orch writes to it. A plain file copy of a WAL database can be corrupt.
set -euo pipefail

: "${BACKUP_DIR:?set BACKUP_DIR to the backup destination}"
keep="${BACKUP_KEEP_DAYS:-14}"
vault="${KPDB:-$HOME/.local/share/keepassxc/secrets.kdbx}"
history="${HISTFILE:-$HOME/.config/zsh/.zsh_history}"
orch="$HOME/.local/share/orch"
sessions="$HOME/.config/pi/agent/sessions"

log() { printf '%s backup-state: %s\n' "$(date '+%F %T')" "$*"; }

[[ -d "$(dirname "$BACKUP_DIR")" ]] || { log "parent of $BACKUP_DIR does not exist"; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
chmod 700 "$work"
snap="$work/snap"
mkdir "$snap"

copy() {
  if [[ -f "$1" ]]; then
    cp -p "$1" "$snap/$2"
  else
    log "skip $1: missing"
  fi
}

copy "$vault" secrets.kdbx
copy "$history" zsh_history
copy "$orch/ledger.json" orch-ledger.json
if [[ -f "$orch/orch.db" ]]; then
  sqlite3 "$orch/orch.db" ".backup '$snap/orch.db'"
  # Leave WAL mode so the copy is one self-contained file.
  check=$(sqlite3 "$snap/orch.db" 'PRAGMA journal_mode=DELETE;' 'PRAGMA integrity_check;' | tail -1)
  [[ "$check" == ok ]] || { log "orch.db snapshot failed integrity_check: $check"; exit 1; }
  rm -f "$snap/orch.db-shm" "$snap/orch.db-wal"
else
  log "skip $orch/orch.db: missing"
fi
chmod 600 "$snap"/*
chmod 700 "$snap"

# Copy in as .partial, then rename, so a reader never sees a partial snapshot.
day=$(date +%F)
dest="$BACKUP_DIR/snapshots/$day"
mkdir -p "$BACKUP_DIR/snapshots"
rm -rf "$dest.partial"
cp -Rp "$snap" "$dest.partial"
rm -rf "$dest"
mv "$dest.partial" "$dest"
log "snapshot $dest"

mkdir -p "$BACKUP_DIR/mirror"
[[ -d "$orch/logs" ]] && rsync -a "$orch/logs/" "$BACKUP_DIR/mirror/orch-logs/"
[[ -d "$sessions" ]] && rsync -a "$sessions/" "$BACKUP_DIR/mirror/pi-sessions/"
log "mirror $BACKUP_DIR/mirror"

# Prune old snapshots. Only directories named YYYY-MM-DD are candidates.
all=$(find "$BACKUP_DIR/snapshots" -mindepth 1 -maxdepth 1 -type d \
  -name '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' | sort)
count=$(grep -c . <<<"$all" || true)
if (( count > keep )); then
  while IFS= read -r d; do
    rm -rf "$d"
    log "prune $d"
  done < <(head -n "$((count - keep))" <<<"$all")
fi
