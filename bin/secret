#!/usr/bin/env bash
# Fetch a secret's Password attribute from the KeePassXC vault, unlocking the
# DB with the master password cached in the macOS keychain.
#
# Usage: secret <entry-path>        e.g.  secret env/OPENAI_API_KEY
#
# Used both interactively (via the zsh `secret` wrapper) and by pi's
# `!command` config syntax so provider/API keys never touch disk or history.
set -euo pipefail

KPDB="${KPDB:-$HOME/.local/share/keepassxc/secrets.kdbx}"
entry="${1:?usage: secret <entry-path>}"

security find-generic-password -a "$USER" -s keepassxc-db -w \
  | keepassxc-cli show -a Password -q "$KPDB" "$entry"
