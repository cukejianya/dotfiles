#!/bin/bash

# Script to create a PR using gh CLI with Claude-generated descriptions
# Usage: ./generate-pr.sh

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get current branch name
CURRENT_BRANCH=$(git branch --show-current)

# Get the main branch name (try master first, then main)
MAIN_BRANCH=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5 2>/dev/null || echo "master")

echo -e "${YELLOW}Current branch: $CURRENT_BRANCH${NC}"
echo -e "${YELLOW}Target branch: $MAIN_BRANCH${NC}"
echo ""


# Check if we're not on main/master
if [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ]; then
    echo -e "${RED}Error: You're on the main branch. Please create a feature branch first.${NC}"
    exit 1
fi

# Check if gh CLI is installed
if ! command -v gh &> /dev/null; then
    echo -e "${RED}Error: gh CLI is not installed. Please install it first.${NC}"
    exit 1
fi

# Check if user is authenticated with gh
if ! gh auth status &> /dev/null; then
    echo -e "${RED}Error: Not authenticated with GitHub. Run 'gh auth login' first.${NC}"
    exit 1
fi

# Check if claude CLI is available
if ! command -v claude &> /dev/null; then
    echo -e "${RED}Error: Claude CLI is not installed. Please install it first.${NC}"
    exit 1
fi

# Function to generate PR description using Claude
generate_pr_description() {
    local branch_name="$1"
    local commits="$2"
    local changed_files="$3"

    echo -e "${BLUE}🤖 Generating PR description with Claude...${NC}"

    # Extract ticket ID from branch name if present (e.g., PROJ-123-some-feature)
    local ticket_id=""
    if [[ $branch_name =~ ([A-Z]+-[0-9]+) ]]; then
        ticket_id="${BASH_REMATCH[1]}"
    fi

    # JIRA_BASE_URL comes from the private work overlay, if present.
    local jira_hint=""
    if [[ -n "$ticket_id" && -n "${JIRA_BASE_URL:-}" ]]; then
        jira_hint=" Mention the ticket as: Link to Jira Issue: ${JIRA_BASE_URL}/browse/$ticket_id"
    fi

    # Create prompt for Claude
    local prompt="Analyze the following git changes and generate a PR description in this exact format:

<!-- pr-description-bot describe -->
## Overview
[Brief overview of what this PR does]

## Why?
[Explanation of why this change is needed.$jira_hint]

## What are the changes?
[Bullet points of key changes using conventional commit prefixes like feat:, fix:, chore:, etc.]

<!-- pr-description-bot -->

$(if [ -n "$ticket_id" ]; then echo "Ticket: $ticket_id"; fi)

Git commits:
$commits

Changed files:
$changed_files

Please analyze these changes and generate a professional PR description following the format above."

    # Use Claude to generate description
    echo "$prompt" | claude 2>/dev/null || {
        echo -e "${RED}Error: Failed to generate description with Claude.${NC}"
        return 1
    }
}

# Get commit messages since branching from main
echo -e "${YELLOW}Recent commits:${NC}"
COMMITS=$(git log --oneline $MAIN_BRANCH..$CURRENT_BRANCH)
echo "$COMMITS"
echo ""

# Get changed files
echo -e "${YELLOW}Changed files:${NC}"
CHANGED_FILES=$(git diff $MAIN_BRANCH..HEAD --name-only)
echo "$CHANGED_FILES"
echo ""

GENERATED_DESCRIPTION=$(generate_pr_description "$CURRENT_BRANCH" "$COMMITS" "$CHANGED_FILES") 
echo "$GENERATED_DESCRIPTION"
echo "$GENERATED_DESCRIPTION" > pbcopy
exit 0

# Prompt for title
echo -e "${YELLOW}Enter PR title:${NC}"
read -r PR_TITLE

if [ -z "$PR_TITLE" ]; then
    echo -e "${RED}Error: PR title cannot be empty.${NC}"
    exit 1
fi

# Generate PR description with Claude
echo ""
GENERATED_DESCRIPTION=$(generate_pr_description "$CURRENT_BRANCH" "$COMMITS" "$CHANGED_FILES")

if [ $? -eq 0 ] && [ -n "$GENERATED_DESCRIPTION" ]; then
    echo -e "${GREEN}Generated description:${NC}"
    echo "---"
    echo "$GENERATED_DESCRIPTION"
    echo "---"
    echo ""

    # Ask if user wants to use generated description
    read -p "Use this generated description? (Y/n): " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Nn]$ ]]; then
        echo -e "${YELLOW}Enter custom PR description (press Ctrl+D when done):${NC}"
        PR_BODY=$(cat)
        if [ -z "$PR_BODY" ]; then
            echo -e "${YELLOW}Warning: PR description is empty. Continuing...${NC}"
        fi
    else
        PR_BODY="$GENERATED_DESCRIPTION"
    fi
else
    echo -e "${YELLOW}Failed to generate description. Please enter manually:${NC}"
    echo -e "${YELLOW}Enter PR description (press Ctrl+D when done):${NC}"
    PR_BODY=$(cat)
    if [ -z "$PR_BODY" ]; then
        echo -e "${YELLOW}Warning: PR description is empty. Continuing...${NC}"
    fi
fi

# Confirm before creating PR
echo ""
echo -e "${YELLOW}Creating PR with:${NC}"
echo -e "${GREEN}Title: $PR_TITLE${NC}"
echo -e "${GREEN}Body: $PR_BODY${NC}"
echo -e "${GREEN}From: $CURRENT_BRANCH${NC}"
echo -e "${GREEN}To: $MAIN_BRANCH${NC}"
echo ""

read -p "Continue? (y/N): " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Cancelled.${NC}"
    exit 0
fi

# Create the PR
echo -e "${YELLOW}Creating pull request...${NC}"

if [ -z "$PR_BODY" ]; then
    gh pr create --title "$PR_TITLE" --base "$MAIN_BRANCH"
else
    gh pr create --title "$PR_TITLE" --body "$PR_BODY" --base "$MAIN_BRANCH"
fi

if [ $? -eq 0 ]; then
    echo -e "${GREEN}✅ Pull request created successfully!${NC}"
    
    # Show the created PR
    PR_URL=$(gh pr view --json url --jq .url)
    echo -e "${GREEN}PR URL: $PR_URL${NC}"
else
    echo -e "${RED}❌ Failed to create pull request.${NC}"
    exit 1
fi
