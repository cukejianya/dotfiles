#! /usr/bin/env zsh

local tmux_windows=$(tmux list-windows -a -F "#S:#W #{pane_current_path}")

local worktree_dir
if [ -z "$1" ]; then
  worktree_dir=$(git worktree list | fzf | awk '{ print $1 }') || return ""
else
  worktree_dir=$(git worktree list | awk '{print $0 "|" $0}' | sed 's![^[:space:]]*/\([^[:space:]]*\).*|!\1 | !' | fzf --query="$1" --select-1 --exit-0 --delimiter='\|' --nth=1 | awk '{ print $3 }')
fi

if [[ $(echo "$tmux_windows" | grep -ci "$worktree_dir") -gt 0 ]]; then
  local worktree_tmux_window=$(echo "$tmux_windows" | grep -i "$worktree_dir" | awk '{print $1}')
  tmux switch-client -t "$worktree_tmux_window"
else
  tmux new-window -c "$worktree_dir"
fi
