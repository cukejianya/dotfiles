# This is Git's per-user configuration file.
[user]
	name = Chinedum Ukejianya
	email = cukejianya@gmail.com
[core]
  editor = nvim
[filter "lfs"]
  smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[pager]
  diff = delta --paging "always"
[init]
	defaultBranch = main
[include]
  path = ~/.config/delta/themes.gitconfig
[delta]
  features = weeping-willow
  hyperlinks = true
  side-by-side = false
  hyperlinks-file-link-format = nvim-popup://{path}:{line}
# HTTPS to github.com uses the gh login. Programs such as launchd jobs run git
# with a minimal PATH, so the helper also tries the Homebrew locations for gh.
[credential "https://github.com"]
	helper =
	helper = "!f() { for g in gh /opt/homebrew/bin/gh /home/linuxbrew/.linuxbrew/bin/gh; do command -v \"$g\" >/dev/null 2>&1 && exec \"$g\" auth git-credential \"$@\"; done; echo \"git: gh not found\" >&2; exit 1; }; f"
# Private work overlay: work email, GHE credentials, maintenance repos.
# Git skips an include path that does not exist.
[include]
  path = ~/.dotfiles-work/gitconfig
